# Environment files (never commit real values; .env.example is the template)
.env
.env.local
.env.*.local
**/.env
**/.env.local
!.env.example

# Rust
**/target/
*.rs.bk
# Ledger snapshots written by soroban-sdk testutils. Regenerated by cargo test.
contracts/**/test_snapshots/

# Node
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
.yarn/

# Lockfiles are committed: pnpm-lock.yaml pins the workspace,
# contracts/yield_vault/Cargo.lock pins the Soroban contract build.

# VS Code
.vscode/

# macOS
.DS_Store

# Logs
*.log

# Build artifacts
/dist/
**/dist/
/build/
**/build/
*.tsbuildinfo

# Tooling caches
.eslintcache

# Testnet deployer secret generated by scripts/deploy/deploy-yield-vault.ts.
# Never commit a signing key; use DEPLOYER_SECRET in CI instead.
scripts/.deployer.json

# Creation salt written before initialize. It is in the deploy transaction, so
# it is not a secret, but it is local operator state for retrying initialize.
scripts/.deploy_salt

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*.bak
~*
