{
  "name": "@yieldanchor/constants",
  "version": "0.1.0",
  "private": true,
  "description": "Shared protocol constants: network parameters, contract event topics, error codes, and ingestion defaults",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node init && tsc -p .",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "20.4.2",
    "typescript": "5.4.2",
    "vitest": "^3.2.7"
  }
}
