{
  "name": "@yieldanchor/stellar-utils",
  "version": "0.1.0",
  "private": true,
  "description": "Stellar and Soroban helpers: exact integer arithmetic, amount formatting, address validation, ScVal decoding, and ledger time",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node init && tsc -p .",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "16.0.1",
    "@yieldanchor/constants": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "20.4.2",
    "typescript": "5.4.2",
    "vitest": "^3.2.7"
  }
}
