{
  "name": "@yieldanchor/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node init && tsx watch src/server.ts",
    "build": "node init && tsc -p .",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node init && node dist/server.js"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "16.0.1",
    "@supabase/supabase-js": "2.27.0",
    "@yieldanchor/constants": "workspace:*",
    "@yieldanchor/shared-types": "workspace:*",
    "dotenv": "16.0.3",
    "express": "4.18.2",
    "node-cron": "3.0.2"
  },
  "devDependencies": {
    "@types/express": "4.17.17",
    "@types/node": "20.4.2",
    "tsx": "^4.22.4",
    "typescript": "5.4.2",
    "vitest": "^3.2.7"
  }
}
