{
  "name": "@yieldanchor/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node init && tsx watch src/index.ts",
    "build": "node init && tsc -p .",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node init && node dist/index.js"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "16.0.1",
    "@supabase/supabase-js": "2.27.0",
    "@yieldanchor/constants": "workspace:*",
    "@yieldanchor/shared-types": "workspace:*",
    "@yieldanchor/stellar-utils": "workspace:*",
    "@yieldanchor/validation": "workspace:*",
    "dotenv": "16.0.3"
  },
  "devDependencies": {
    "@types/node": "20.4.2",
    "tsx": "^4.22.4",
    "typescript": "5.4.2",
    "vitest": "^3.2.7"
  }
}
